# Copy to .env. Nothing here is a real credential.
AURELIA_EHR_URL=            # empty = use the bundled synthetic cohort; or http://localhost:8100
AURELIA_EHR_TOKEN=dev-token-change-me
MOCK_EHR_TOKEN=dev-token-change-me
AURELIA_SYNTHETIC_PATIENTS=60
AURELIA_LLM=extractive      # extractive | ollama
AURELIA_OLLAMA_URL=http://localhost:11434
AURELIA_OLLAMA_MODEL=llama3.1
AURELIA_API_KEY=            # set to require X-API-Key on /api/*
AURELIA_AUDIT_PATH=data/audit.jsonl
AURELIA_TOP_K=6
